@@ -0,0 +1,55 @@
+package coredevices.coreapp.mod
+
+import android.app.Activity
+import android.content.Context
+import android.content.Intent
+import android.os.Bundle
+import android.os.Process
+
+/**
+ * Restarts the app (after a staged import). Runs in its own process (":modrestart" in
+ * the manifest): it kills the main process, then launches the app afresh, so
+ * [ModBackup.applyPendingImport] runs before anything opens the databases.
+ */
+class ModRestartActivity : Activity() {
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        val pid = intent.getIntExtra(EXTRA_PID, -1)
+        if (pid > 0) Process.killProcess(pid)
+        packageManager.getLaunchIntentForPackage(packageName)?.let {
+            it.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_CLEAR_TASK)
+            startActivity(it)
+        }
+        finish()
+        Runtime.getRuntime().exit(0)
+    }
+
+    companion object {
+        private const val EXTRA_PID = "pid"
+        private const val PROCESS_SUFFIX = ":modrestart"   // android:process in the manifest
+
+        /** True in the restart helper's process: the Application must not start the app there. */
+        fun isRestartProcess(): Boolean {
+            val name = if (android.os.Build.VERSION.SDK_INT >= 28) {
+                android.app.Application.getProcessName()
+            } else {
+                try {
+                    java.io.File("/proc/self/cmdline").readText().trimEnd('\u0000')
+                } catch (e: Exception) {
+                    ""
+                }
+            }
+            return name.endsWith(PROCESS_SUFFIX)
+        }
+
+        fun restart(context: Context) {
+            context.startActivity(
+                Intent(context, ModRestartActivity::class.java)
+                    .putExtra(EXTRA_PID, Process.myPid())
+                    .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+            )
+            if (context is Activity) context.finishAffinity()
+            Runtime.getRuntime().exit(0)
+        }
+    }
+}
diff --git a/composeApp/src/androidMain/kotlin/coredevices/coreapp/mod/ModUpdate.kt b/composeApp/src/androidMain/kotlin/coredevices/coreapp/mod/ModUpdate.kt
