+package coredevices.coreapp.mod
+
+import android.app.AlertDialog
+import android.os.Bundle
+import android.widget.Toast
+import androidx.activity.ComponentActivity
+import androidx.activity.result.contract.ActivityResultContracts
+import java.text.SimpleDateFormat
+import java.util.Date
+import java.util.Locale
+
+/**
+ * 备份与更新 (personal build): export / import all settings, check for a new build.
+ * Opened from the app icon's long-press menu (res/xml/mod_shortcuts.xml).
+ */
+class ModBackupActivity : ComponentActivity() {
+    private val exportTo = registerForActivityResult(ActivityResultContracts.CreateDocument("application/zip")) { uri ->
+        if (uri == null) { finish(); return@registerForActivityResult }
+        work("正在导出…") {
+            val n = contentResolver.openOutputStream(uri)?.use { ModBackup.export(this, it) }
+                ?: throw IllegalStateException("无法写入所选位置")
+            "已导出 $n 个文件"
+        }
+    }
+
+    private val importFrom = registerForActivityResult(ActivityResultContracts.OpenDocument()) { uri ->
+        if (uri == null) { finish(); return@registerForActivityResult }
+        AlertDialog.Builder(this, android.R.style.Theme_DeviceDefault_Dialog_Alert)
+            .setTitle("导入设置")
+            .setMessage("会用备份替换当前的全部设置和数据，然后 App 自动重启。继续吗？")
+            .setPositiveButton("导入并重启") { _, _ ->
+                work("正在导入…", restart = true) {
+                    contentResolver.openInputStream(uri)?.let { ModBackup.stageImport(this, it) }
+                        ?: throw IllegalStateException("无法读取所选文件")
+                    "导入完成，正在重启"
+                }
+            }
+            .setNegativeButton("取消") { _, _ -> finish() }
+            .setOnCancelListener { finish() }
+            .show()
+    }
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        if (savedInstanceState != null) return
+        when (intent?.action) {
+            ACTION_EXPORT -> startExport()
+            ACTION_IMPORT -> importFrom.launch(arrayOf("application/zip", "application/octet-stream"))
+            ACTION_UPDATE -> checkUpdate()
+            else -> menu()
+        }
+    }
+
+    private fun menu() {
+        AlertDialog.Builder(this, android.R.style.Theme_DeviceDefault_Dialog_Alert)
+            .setTitle("备份与更新（构建 ${ModUpdate.ownBuild}）")
+            .setItems(arrayOf("导出设置…", "导入设置…", "检查更新")) { _, which ->
+                when (which) {
+                    0 -> startExport()
+                    1 -> importFrom.launch(arrayOf("application/zip", "application/octet-stream"))
+                    else -> checkUpdate()
+                }
+            }
+            .setOnCancelListener { finish() }
+            .show()
+    }
+
+    private fun startExport() {
+        val stamp = SimpleDateFormat("yyyyMMdd-HHmm", Locale.US).format(Date())
+        exportTo.launch("pebble-settings-$stamp.zip")
+    }
+
+    private fun checkUpdate() {
+        Toast.makeText(this, "正在检查更新…", Toast.LENGTH_SHORT).show()
+        ModUpdate.checkInBackground(this, force = true) { latest ->
+            runOnUiThread {
+                if (isFinishing || isDestroyed) return@runOnUiThread
+                val b = AlertDialog.Builder(this, android.R.style.Theme_DeviceDefault_Dialog_Alert)
+                    .setOnCancelListener { finish() }
+                when {
+                    !ModUpdate.configured -> b.setMessage("这个构建没有配置更新地址").setPositiveButton("好") { _, _ -> finish() }
+                    latest == null -> b.setMessage("连不上更新服务器，稍后再试").setPositiveButton("好") { _, _ -> finish() }
+                    latest.build > ModUpdate.ownBuild -> b.setTitle("有新版本 ${latest.version}（构建 ${latest.build}）")
+                        .setMessage("下载后点安装即可，设置不会丢失。")
+                        .setPositiveButton("下载") { _, _ -> ModUpdate.openDownload(this); finish() }
+                        .setNegativeButton("以后") { _, _ -> finish() }
+                    else -> b.setMessage("已是最新版本 ${latest.version}（构建 ${ModUpdate.ownBuild}）").setPositiveButton("好") { _, _ -> finish() }
+                }
+                b.show()
+            }
+        }
+    }
+
+    private fun work(label: String, restart: Boolean = false, job: () -> String) {
+        Toast.makeText(this, label, Toast.LENGTH_SHORT).show()
+        Thread {
+            val result = try { Result.success(job()) } catch (e: Exception) { Result.failure(e) }
+            runOnUiThread {
+                result.onSuccess { msg ->
+                    Toast.makeText(this, msg, Toast.LENGTH_LONG).show()
+                    if (restart) ModRestartActivity.restart(this) else finish()
+                }.onFailure { e ->
+                    AlertDialog.Builder(this, android.R.style.Theme_DeviceDefault_Dialog_Alert)
+                        .setTitle("失败")
+                        .setMessage(e.message ?: e.toString())
+                        .setPositiveButton("好") { _, _ -> finish() }
+                        .setOnCancelListener { finish() }
+                        .show()
+                }
+            }
+        }.start()
+    }
+
+    companion object {
+        const val ACTION_EXPORT = "coredevices.coreapp.mod.EXPORT"
+        const val ACTION_IMPORT = "coredevices.coreapp.mod.IMPORT"
+        const val ACTION_UPDATE = "coredevices.coreapp.mod.UPDATE"
+    }
+}
