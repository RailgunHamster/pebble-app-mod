diff --git a/composeApp/src/androidMain/kotlin/coredevices/coreapp/mod/ModBackup.kt b/composeApp/src/androidMain/kotlin/coredevices/coreapp/mod/ModBackup.kt
new file mode 100644
index 0000000..641e1ac
--- /dev/null
+++ b/composeApp/src/androidMain/kotlin/coredevices/coreapp/mod/ModBackup.kt
@@ -0,0 +1,140 @@
+package coredevices.coreapp.mod
+
+import android.content.Context
+import android.os.Build
+import org.json.JSONObject
+import java.io.File
+import java.io.InputStream
+import java.io.OutputStream
+import java.util.zip.ZipEntry
+import java.util.zip.ZipFile
+import java.util.zip.ZipInputStream
+import java.util.zip.ZipOutputStream
+
+/**
+ * Backup of the app's settings and data (personal build): everything in the app's data
+ * directory that describes the setup (Room databases, shared preferences, watchapp
+ * settings, installed .pbw files, WebView storage), without caches, downloaded speech
+ * models and recordings.
+ *
+ * Import can't overwrite databases the running app has open, so it is staged
+ * ([stageImport]) and applied by [applyPendingImport] at the very start of the next
+ * process, before anything opens them; [ModRestartActivity] provides that restart.
+ */
+object ModBackup {
+    private const val META = "settings-backup.json"
+    private const val PENDING = "settings-import.zip"
+
+    private val skipTop = setOf("cache", "code_cache", "no_backup", "lib")
+    private val skipFiles = listOf(
+        "files/models", "files/recordings", "files/sideload.pbz", "files/$PENDING",
+        "files/.crashlytics.v3",                      // crash reports, not settings
+        "app_webview/variations_seed_new", "app_webview/variations_stamp",
+        "app_webview/last-exit-info", "app_webview/webview_data.lock",
+    )
+
+    /** Paths (relative to the data dir, '/'-separated) that a backup neither saves nor replaces. */
+    fun excluded(relPath: String): Boolean {
+        val p = relPath.replace('\\', '/').trimEnd('/')
+        if (p.isEmpty()) return false
+        if (p.substringBefore('/') in skipTop) return true
+        if (skipFiles.any { p == it || p.startsWith("$it/") }) return true
+        val name = p.substringAfterLast('/')
+        if (name.endsWith(".lck")) return true                  // SQLite lock files
+        // WorkManager's job queue and Google/Firebase internals belong to this install only
+        if (p.startsWith("databases/") && (name.startsWith("androidx.work") || name.startsWith("com.google"))) return true
+        if (p.startsWith("shared_prefs/") && (name.startsWith("com.google") || name.startsWith("mod_update"))) return true
+        if (p.startsWith("app_webview/") && p.split('/').any {
+                it.contains("cache", ignoreCase = true) || it == "Crashpad" || it == "blob_storage"
+            }) return true
+        return false
+    }
+
+    private fun dataDir(context: Context): File = context.dataDir.canonicalFile
+
+    /** Writes the backup zip to [out]; returns the number of files saved. */
+    fun export(context: Context, out: OutputStream): Int {
+        val root = dataDir(context)
+        var count = 0
+        ZipOutputStream(out.buffered()).use { zip ->
+            val meta = JSONObject()
+                .put("package", context.packageName)
+                .put("created", System.currentTimeMillis())
+                .put("device", "${Build.MANUFACTURER} ${Build.MODEL}")
+            zip.putNextEntry(ZipEntry(META))
+            zip.write(meta.toString(1).toByteArray())
+            zip.closeEntry()
+            root.walkTopDown()
+                .onEnter { dir -> dir == root || !excluded(dir.relativeTo(root).invariantSeparatorsPath) }
+                .filter { it.isFile && !excluded(it.relativeTo(root).invariantSeparatorsPath) }
+                .forEach { file ->
+                    try {
+                        file.inputStream().use { input ->
+                            zip.putNextEntry(ZipEntry(file.relativeTo(root).invariantSeparatorsPath))
+                            input.copyTo(zip)
+                            zip.closeEntry()
+                        }
+                        count++
+                    } catch (e: Exception) {
+                        // a file that vanished or can't be read: skip it
+                    }
+                }
+        }
+        return count
+    }
+
+    /** Copies a backup zip into place for the next start. Throws if it isn't one of ours. */
+    fun stageImport(context: Context, input: InputStream) {
+        val dest = File(context.filesDir, PENDING)
+        val tmp = File(context.filesDir, "$PENDING.part")
+        input.use { inp -> tmp.outputStream().use { inp.copyTo(it) } }
+        var meta: JSONObject? = null
+        ZipInputStream(tmp.inputStream().buffered()).use { zip ->
+            while (true) {
+                val e = zip.nextEntry ?: break
+                if (e.name == META) {
+                    meta = JSONObject(zip.readBytes().decodeToString())
+                    break
+                }
+            }
+        }
+        val pkg = meta?.optString("package")
+        if (pkg != context.packageName) {
+            tmp.delete()
+            throw IllegalArgumentException(if (meta == null) "不是本 App 导出的备份文件" else "备份来自另一个 App（$pkg）")
+        }
+        if (!tmp.renameTo(dest)) {
+            tmp.delete()
+            throw IllegalStateException("无法保存备份文件")
+        }
+    }
+
+    /** Applies a staged import. Call first thing in Application.onCreate. */
+    fun applyPendingImport(context: Context) {
+        val zipFile = File(context.filesDir, PENDING)
+        if (!zipFile.exists()) return
+        val root = dataDir(context)
+        val rootPath = root.path + File.separator
+        try {
+            ZipFile(zipFile).use { zip ->
+                // replace, don't merge: clear what a backup covers first
+                for (top in listOf("databases", "shared_prefs", "files", "app_webview")) {
+                    File(root, top).walkBottomUp()
+                        .filter { it.isFile && !excluded(it.relativeTo(root).invariantSeparatorsPath) }
+                        .forEach { it.delete() }
+                }
+                for (entry in zip.entries()) {
+                    if (entry.isDirectory || entry.name == META || excluded(entry.name)) continue
+                    val dest = File(root, entry.name).canonicalFile
+                    if (!dest.path.startsWith(rootPath)) continue   // no "../" escapes
+                    dest.parentFile?.mkdirs()
+                    zip.getInputStream(entry).use { input -> dest.outputStream().use { input.copyTo(it) } }
+                }
+            }
+        } catch (e: Exception) {
+            // a broken backup must not keep the app from starting
+        } finally {
+            zipFile.delete()
+        }
+    }
+}
