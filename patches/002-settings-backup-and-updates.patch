index 0000000..35cbc27
--- /dev/null
+++ b/composeApp/src/androidMain/kotlin/coredevices/coreapp/mod/ModUpdate.kt
@@ -0,0 +1,118 @@
+package coredevices.coreapp.mod
+
+import android.Manifest
+import android.app.Notification
+import android.app.NotificationChannel
+import android.app.NotificationManager
+import android.app.PendingIntent
+import android.content.Context
+import android.content.Intent
+import android.content.pm.PackageManager
+import android.net.Uri
+import android.os.Build
+import coredevices.util.CommonBuildKonfig
+import org.json.JSONObject
+import java.net.HttpURLConnection
+import java.net.URL
+import java.net.URLEncoder
+
+/**
+ * Update check for the personal build. CI uploads each build to the clawfeed relay on tc,
+ * which keeps only the newest one:
+ *   GET {MOD_UPDATE_URL}/latest   -> {"version": "1.15.0.1", "build": 12, "size": ...}
+ *   GET {MOD_UPDATE_URL}/apk?t=   -> the APK (the browser downloads it, Android installs it)
+ * authorized with the same token as dictation (KIRINKI_TOKEN). A build is newer when its
+ * CI build number is higher than ours (MOD_BUILD).
+ */
+object ModUpdate {
+    data class Latest(val version: String, val build: Int, val size: Long)
+
+    private const val PREFS = "mod_update"
+    private const val CHANNEL = "mod_update"
+    private const val NOTIFY_ID = 0xC1A0
+    private const val INTERVAL_MS = 12L * 3600 * 1000
+
+    val ownBuild: Int get() = CommonBuildKonfig.MOD_BUILD.toIntOrNull() ?: 0
+
+    val configured: Boolean
+        get() = !CommonBuildKonfig.MOD_UPDATE_URL.isNullOrBlank() && !CommonBuildKonfig.KIRINKI_TOKEN.isNullOrBlank()
+
+    fun downloadUri(): Uri? {
+        val base = CommonBuildKonfig.MOD_UPDATE_URL?.trimEnd('/') ?: return null
+        val token = CommonBuildKonfig.KIRINKI_TOKEN ?: return null
+        return Uri.parse("$base/apk?t=" + URLEncoder.encode(token, "UTF-8"))
+    }
+
+    /** Blocking; null when there's nothing published or the relay can't be reached. */
+    fun fetchLatest(): Latest? {
+        val base = CommonBuildKonfig.MOD_UPDATE_URL?.trimEnd('/') ?: return null
+        val token = CommonBuildKonfig.KIRINKI_TOKEN ?: return null
+        val conn = URL("$base/latest").openConnection() as HttpURLConnection
+        return try {
+            conn.connectTimeout = 10_000
+            conn.readTimeout = 15_000
+            conn.setRequestProperty("Authorization", "Bearer $token")
+            if (conn.responseCode != 200) return null
+            val j = JSONObject(conn.inputStream.bufferedReader().readText())
+            Latest(j.optString("version"), j.optInt("build"), j.optLong("size"))
+        } finally {
+            conn.disconnect()
+        }
+    }
+
+    /**
+     * Checks at most every 12 h (or now with [force]); a newer build posts a notification
+     * that opens the download. [onResult] runs on the checking thread.
+     */
+    fun checkInBackground(context: Context, force: Boolean = false, onResult: ((Latest?) -> Unit)? = null) {
+        if (!configured) {
+            onResult?.invoke(null)
+            return
+        }
+        val app = context.applicationContext
+        val prefs = app.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+        val now = System.currentTimeMillis()
+        if (!force && now - prefs.getLong("checked", 0) < INTERVAL_MS) return
+        Thread {
+            val latest = try { fetchLatest() } catch (e: Exception) { null }
+            prefs.edit().putLong("checked", now).apply()
+            if (latest != null && latest.build > ownBuild && !force &&
+                prefs.getInt("notified", 0) != latest.build
+            ) {
+                notifyNewer(app, latest)
+                prefs.edit().putInt("notified", latest.build).apply()
+            }
+            onResult?.invoke(latest)
+        }.apply {
+            isDaemon = true
+            name = "mod-update"
+        }.start()
+    }
+
+    fun openDownload(context: Context) {
+        val uri = downloadUri() ?: return
+        context.startActivity(Intent(Intent.ACTION_VIEW, uri).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK))
+    }
+
+    private fun notifyNewer(context: Context, latest: Latest) {
+        if (Build.VERSION.SDK_INT >= 33 &&
+            context.checkSelfPermission(Manifest.permission.POST_NOTIFICATIONS) != PackageManager.PERMISSION_GRANTED
+        ) return
+        val uri = downloadUri() ?: return
+        val nm = context.getSystemService(NotificationManager::class.java) ?: return
+        nm.createNotificationChannel(NotificationChannel(CHANNEL, "App 更新", NotificationManager.IMPORTANCE_DEFAULT))
+        val tap = PendingIntent.getActivity(
+            context, 0, Intent(Intent.ACTION_VIEW, uri),
+            PendingIntent.FLAG_IMMUTABLE or PendingIntent.FLAG_UPDATE_CURRENT,
+        )
+        val mb = if (latest.size > 0) "（${latest.size / (1024 * 1024)} MB）" else ""
+        val n = Notification.Builder(context, CHANNEL)
+            .setSmallIcon(android.R.drawable.stat_sys_download_done)
+            .setContentTitle("Pebble App 有新版本 ${latest.version}")
+            .setContentText("点按下载安装$mb，设置不会丢失")
+            .setContentIntent(tap)
+            .setAutoCancel(true)
+            .build()
+        nm.notify(NOTIFY_ID, n)
+    }
+}
